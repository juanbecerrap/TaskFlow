# Copia este archivo como ".env" y completa los valores con los de tu
# proyecto de Firebase (Configuración del proyecto > Tus apps > App web).
# El archivo ".env" real NUNCA se sube a Git.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Usa "true" para conectar la app a los emuladores locales de Firebase.
VITE_USE_FIREBASE_EMULATORS=false